# Cloudflare Workers static assets headers
# Practice project: keep every page out of search engines, so it is never mistaken
# for the official website of the shelter.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# Hashed build assets never change: cache them for a year.
# HTML keeps Cloudflare's default (max-age=0, must-revalidate), so a status change
# such as "adoptado" is visible as soon as the deploy finishes (criterion E3).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
