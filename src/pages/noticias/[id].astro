---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNoticias, fecha } from '../../lib/contenido';

export async function getStaticPaths() {
  const noticias = await getNoticias();
  return noticias.map((noticia) => ({ params: { id: noticia.id }, props: { noticia } }));
}

const { noticia } = Astro.props;
const { titulo, tipo, fecha: dia, lugar, resumen, imagen, alt } = noticia.data;
const { Content } = await render(noticia);
---

<Base title={titulo} description={resumen}>
  <article class="contenedor seccion prosa">
    <p class="volver"><a href="/noticias/">← Todas las noticias</a></p>
    <span class={`etiqueta etiqueta--${tipo}`}>{tipo === 'evento' ? 'Evento' : 'Noticia'}</span>
    <h1>{titulo}</h1>
    <p class="meta">
      {tipo === 'evento' ? 'Fecha: ' : 'Publicada el '}
      <time datetime={dia.toISOString().slice(0, 10)}>{fecha(dia)}</time>
      {tipo === 'evento' && lugar && <><br />Lugar: {lugar}</>}
    </p>
    <p class="intro">{resumen}</p>
    {
      imagen && (
        <Image
          src={imagen}
          alt={alt ?? ''}
          widths={[480, 800, 1200]}
          sizes="(max-width: 44rem) 100vw, 42rem"
          loading="eager"
          class="foto"
        />
      )
    }
    <Content />
  </article>
</Base>

<style>
  .volver {
    font-weight: 700;
  }

  .meta {
    color: var(--muted);
    font-weight: 700;
  }

  .foto {
    width: 100%;
    border-radius: var(--radius);
    margin-block: 1.5rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
</style>
