---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { ajustes } from '../lib/ajustes';

// Fixed pages: the Markdown file name in src/content/paginas/ becomes the URL
export async function getStaticPaths() {
  const paginas = await getCollection('paginas');
  return paginas.map((pagina) => ({ params: { pagina: pagina.id }, props: { pagina } }));
}

const { pagina } = Astro.props;
const { titulo, intro } = pagina.data;
const { Content } = await render(pagina);
---

<Base title={titulo} description={intro}>
  <article class="contenedor seccion prosa">
    <h1>{titulo}</h1>
    <p class="intro">{intro}</p>
    <Content />

    {
      pagina.id === 'colaborar' && (
        <p>
          <a class="boton" href={ajustes.teaming} rel="noopener">
            Hazte teamer
          </a>
        </p>
      )
    }

    {
      pagina.id === 'contacto' && (
        <div class="contacto">
          <h2>Correo electrónico</h2>
          <p>
            <a href={`mailto:${ajustes.email}`}>{ajustes.email}</a>
          </p>
          <p class="nota">
            Es una dirección de ejemplo: esta web es un proyecto de prácticas y no muestra datos de contacto reales.
          </p>
        </div>
      )
    }
  </article>
</Base>

<style>
  .contacto {
    margin-top: 2rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--surface-alt);
  }

  .contacto h2 {
    margin-top: 0;
  }

  .nota {
    color: var(--muted);
    margin: 0;
  }
</style>
